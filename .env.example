# ─── TARGET MODEL API KEYS ───────────────────────────────────────────────────
# OpenAI (GPT-3.5 / GPT-4)
OPENAI_API_KEY=sk-proj-YourOpenAIKeyHere

# Google (Gemini)
GOOGLE_API_KEY=AIzaSyYourGoogleKeyHere

# Optional: Anthropic (if extending the platform)
# ANTHROPIC_API_KEY=sk-ant-YourAnthropicKeyHere

# ─── SCHEDULER CONFIGURATION ─────────────────────────────────────────────────
# Time of day for the scheduled audit (24h format, default 03:00)
SCHEDULE_TIME=03:00

# Default model if scheduler_config.json is not present
TARGET_MODEL=OpenAI-GPT3.5

# API key used by the scheduler container
LLM_API_KEY=YourKeyHere

# Set to "true" to enable automatic model discovery via provider APIs
AUTO_DISCOVER_MODELS=false

# ─── ENVIRONMENT ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
